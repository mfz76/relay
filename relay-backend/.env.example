# ==========================================
# RELAY AUTOMATION BACKEND - ENVIRONMENT VARIABLES
# All keys are optional. If not provided, Relay will run
# in simulation/demo mode without breaking or throwing errors.
# ==========================================

# 1. Google Gemini AI API Key (Optional)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Slack Incoming Webhook (Optional)
# Create a free incoming webhook for your Slack workspace channel
# Example: https://hooks.slack.com/services/T00/B00/XXXX
SLACK_WEBHOOK_URL=

# 3. Gmail SMTP Configuration (Optional)
# Use your Gmail address and a 16-character Google App Password:
# (Google Account > Security > 2-Step Verification > App Passwords)
GMAIL_SMTP_USER=
GMAIL_SMTP_PASSWORD=
GMAIL_FROM_NAME="Relay Customer Support"
SUPPORT_EMAIL=

# 4. Google Sheets & Calendar (Optional)
# Path to service account JSON file and target Google Sheet ID
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=
